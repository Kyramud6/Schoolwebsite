#!/bin/bash

set -euo pipefail
umask 077
trap 'rm -f /tmp/wp-db-secret.json /tmp/wp-cli.phar /tmp/wordpress.tar.gz' EXIT

dnf install -y httpd php php-mysqlnd php-gd php-xml hp-mbstring php-intl php-zip amazon-efs-utils mariadb105 jq tar curl
systemctl enable --now httpd

mkdir -p /mnt/wordpress-efs /var/www/html
until mount -t efs -o tls ${efs_id}:/ /mnt/wordpress-efs; do
    sleep 10
done
echo '${efs_id}:/ /mnt/wordpress-efs efs _netdev.tls 0 0' >> /etc/fstab

curl -fsSL https://wordpress.org/latest.tar.gz -o /tmp/wordpress.tar.gz
tar -xzf /tmp/wordpress.tar.gz --strip-components=1 -C /var/www/html
mkdir -p /mnt/wordpress-efs/wp-content
if [ ! -f /mnt/wordpress-efs/wp-content/.initialized ]; then 
    cp -a /var/www/html/wp-content/. /mnt/wordpress-efs/wp-content/
    touch /mnt/wordpress-efs/wp-content/.initialized
fi
rm -rf /var/www/html/wp-content
ln -s /mnt/wordpress-efs/wp-content /var/www/html/wp-content

chown -R apache:apache /var/www/html
chown -R apache:apache /mnt/wordpress-efs/wp-content
chmod 755 /var/www/html

aws configure set region ${aws_region}
exec 9>/mnt/wordpress-efs/.db-setup.lock
flock 9

if ! aws secretmanager get-secret-value --secret-id ${app_secret_arn} --query SecretString --output text > /tmp/wp-db-secret.json 2>/dev/null; then
    aws secretmanager get-secret-value --secret-id ${master_secret_arn} --query SecretString --output text > /tmp/rds-master_secret.json
    MASTER_USER=$(jq -r '.username' /tmp/rds-master-secret.json)
    MASTER_PASSWORD=$(jq -r '.password' /tmp/rds-master-secret.json)
     APP_PASSWORD=$(openssl rand -hex 24)
    MYSQL_PWD="$MASTER_PASSWORD" mysql --host=${db_address} --user="$MASTER_USER" --execute="CREATE USER IF NOT EXISTS 'wpapp'@'%' IDENTIFIED BY '$APP_PASSWORD'; ALTER USER 'wpapp'@'%' IDENTIFIED BY '$APP_PASSWORD'; GRANT ALL PRIVILEGES ON \`${db_name}\`.* TO 'wpapp'@'%';"
    jq -n --arg username 'wpapp' --arg password "$APP_PASSWORD" '{username:$username,password:$password}' > /tmp/wp-db-secret.json
    aws secretsmanager put-secret-value --secret-id ${app_secret_arn} --secret-string file:///tmp/wp-db-secret.json
fi

APP_USER=$(jq -r '.username' /tmp/wp-db-secret.json)
APP_PASSWORD=$(jq -r '.password' /tmp/wp-db-secret.json)
curl -fsSLo /tmp/wp-cli.phar https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
php /tmp/wp-cli.phar --allow-root config create --path=/var/www/html --dbname=${db_name} --dbuser="$APP_USER" --dbpass="APP_PASSWORD" --dbhost=${db_address} --skip-check
chown apache:apache /var/www/html/wp-config.php
systemctl restart httpd